# --- required (server-only) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- model configuration ---
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_PRO=gemini-pro-latest
GEMINI_THINKING_DEFAULT=-1
GEMINI_MAX_TOKENS_PLAN=20000
GEMINI_MAX_TOKENS_DESIGN=20000
GEMINI_MAX_TOKENS_PAGE=30000
GEMINI_MAX_TOKENS_REPAIR=20000
GEMINI_MAX_TOKENS_EDIT=20000
GEMINI_STREAM_PAGE=true
GEMINI_SAFETY_BLOCK_ONLY_HIGH=true

# --- mock/provider fallback ---
GEMINI_MOCK=0
GEMINI_USE_MOCK_IF_NO_KEY=1

# --- deployment providers ---
DEPLOY_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=          # Pages:Edit scope recommended
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
GITHUB_TOKEN=
GITHUB_REPO=

# --- runtime ---
PORT=3000
HOST=0.0.0.0
SITE_TTL_HOURS=72
MAX_SITES_IN_MEMORY=20
RATE_LIMIT_PER_HOUR=10
MAX_CONCURRENT_GENERATIONS=2
CORS_ALLOWED_ORIGINS=

# --- QA/Playwright/Lighthouse (optional) ---
ENABLE_PLAYWRIGHT_QA=1
ENABLE_LIGHTHOUSE_QA=1
LIGHTHOUSE_MOBILE_ONLY=1
REPAIR_MAX_ATTEMPTS=3
UPLOAD_CONCURRENCY=4
FILES_MAX_PER_SITE=60
FILE_MAX_BYTES=256000           # 250 KB
CALL_TIMEOUT_MS=45000
TOTAL_RETRIES_MAX=6
SLICE_BYTES_ON_MAX_TOKENS=8000

# --- preview/security ---
SANDBOX_PREVIEW=allow-scripts allow-forms allow-same-origin
ALLOW_INLINE_INLINE_STYLE_FOR_SINGLE_FILE=1

# --- logging ---
LOG_LEVEL=info
PREVENT_KEY_LOGS=1
